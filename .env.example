# ===========================================
# RoutePay Environment Variables
# ===========================================
# Copy this file to .env and fill in values.

# --- Application ---
APP_NAME=RoutePay
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-string

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./routepay.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/routepay

# --- MoMo API ---
MOMO_ENV=mock                # mock | sandbox | live
MOMO_COLLECTIONS_URL=https://sandbox.momodeveloper.mtn.com/collection/v1_0
MOMO_DISBURSEMENTS_URL=https://sandbox.momodeveloper.mtn.com/disbursement/v1_0
MOMO_REMITTANCES_URL=https://sandbox.momodeveloper.mtn.com/remittance/v1_0
MOMO_PAYMENTS_URL=https://sandbox.momodeveloper.mtn.com/payment/v1_0
MOMO_SUBSCRIPTION_KEY=your-subscription-key
MOMO_API_USER=your-api-user-uuid
MOMO_API_KEY=your-api-key
MOMO_ENVIRONMENT=sandbox      # sandbox | production
MOMO_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/momo

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- OTP Provider (mock for hackathon) ---
OTP_PROVIDER=mock             # mock | twilio | africastalking

# --- External Services ---
MAPBOX_TOKEN=pk.your-mapbox-token

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
